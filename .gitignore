__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
node_modules/
dist/
.DS_Store
.env
.env.*

# Frontend build output — produced by the Vite build on Frappe Cloud, never committed.
apps/*/*/public/frontend/
apps/*/frontend/auto-imports.d.ts
apps/*/frontend/components.d.ts
apps/*/frontend/*.d.ts
# Frappe Cloud installs with yarn; an npm lockfile here would be ignored and misleading.
apps/*/frontend/package-lock.json
apps/oneapp/oneapp/www/one.html
apps/oneapp_control/oneapp_control/www/admin.html
# Copied from admin.html at build time, so it carries the same hashed asset
# tags. Committing it guarantees it goes stale against the next build.
apps/oneapp_control/oneapp_control/www/portal.html

# Redis writes its snapshot into whatever directory it was started from.
dump.rdb
