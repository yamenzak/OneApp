__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
node_modules/
dist/
.DS_Store
.env
.env.*

# Frontend build output — produced by the Vite build on Frappe Cloud, never committed.
apps/*/*/public/frontend/
apps/*/frontend/auto-imports.d.ts
apps/*/frontend/components.d.ts
apps/*/frontend/*.d.ts
# Frappe Cloud installs with yarn, so the npm lockfile here would be ignored and
# misleading — but yarn.lock is committed, deliberately. Without it FC resolves
# dependency versions freshly on every build, so two deploys of one commit can
# produce different bundles and a transitive update can break a release with no
# code change.
apps/*/frontend/package-lock.json
apps/oneapp/oneapp/www/one.html
apps/oneapp_control/oneapp_control/www/signup.html

# Redis writes its snapshot into whatever directory it was started from.
dump.rdb

# Live-patch state: which patch this checkout put on which bench.
.oneapp-live.json

# Worktree used to rebuild the deployed commit for asset diffs.
.oneapp-live-base/

# Playwright output.
apps/*/frontend/test-results/
apps/*/frontend/playwright-report/
